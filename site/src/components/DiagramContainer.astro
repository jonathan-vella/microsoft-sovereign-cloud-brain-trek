---
/**
 * DiagramContainer.astro
 *
 * Collapsible wrapper for complex Mermaid or image diagrams:
 *
 *   <DiagramContainer title="Azure Arc overview" defaultOpen>
 *
 *   ```mermaid
 *   graph TB
 *     A --> B
 *   ```
 *
 *   </DiagramContainer>
 *
 * Children pass through unmodified so rehype-mermaid-lite still sees the fenced block. Mermaid
 * draws diagrams in a closed container when it is opened (see the init script in
 * astro.config.mjs), because it cannot measure text while hidden. Wide diagrams and tables
 * scroll horizontally inside the body instead of being clipped.
 *
 * Props:
 *   title       - required. Plain text label shown in the summary row.
 *   defaultOpen - if true, the diagram is expanded on first paint.
 */
interface Props {
  title: string;
  defaultOpen?: boolean;
}

const { title, defaultOpen = false } = Astro.props;
---

<details class="diagram-container" open={defaultOpen}>
  <summary>{title}</summary>
  <div class="diagram-body">
    <slot />
  </div>
</details>
