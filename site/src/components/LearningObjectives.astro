---
/**
 * LearningObjectives.astro
 *
 * "Learning objectives" panel for the top of a content page. Children are rendered as MDX, so
 * pass a Markdown list:
 *
 *   <LearningObjectives>
 *     - Understand cloud service models (IaaS, PaaS, SaaS).
 *     - Compare public, private, hybrid, and multicloud deployments.
 *   </LearningObjectives>
 *
 * Module landing pages use the `module.objectives` front matter field instead.
 */
interface Props {
  /** Override the default heading (default: "Learning objectives"). */
  title?: string;
}
const { title = "Learning objectives" } = Astro.props;
---

<aside class="learning-objectives" aria-label={title}>
  <p class="learning-objectives__title">{title}</p>
  <slot />
</aside>
